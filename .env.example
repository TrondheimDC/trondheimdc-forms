# Copy to .env.local (git-ignored) for `pnpm dev`. Never commit the real values.

# Point development at another Nextcloud than "nextcloudUrl" in forms.config.json.
# NEXTCLOUD_URL=https://cloud.example.org

# Secret of the OAuth client registered for http://localhost:3000/auth/callback
# (docs/deploy.md). Without it, logging in fails; public forms still work.
FORMS_OAUTH_CLIENT_SECRET=
